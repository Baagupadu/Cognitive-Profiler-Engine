# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL (used by docker compose)
POSTGRES_USER=cpe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cpe
POSTGRES_PORT=5432

# Backend
# DATABASE_URL is used when you run the backend directly on your machine.
# Docker Compose builds its own URL that points at the "db" service.
# If the password has special characters, URL-encode them.
DATABASE_URL=postgresql+asyncpg://cpe:change-me@localhost:5432/cpe
LOG_LEVEL=INFO
BACKEND_PORT=8000
